# communication channel
PORT=5000

# connection address string for our database
MONGO_URI=mongodb://localhost:27017/dtube

# private security key used for cryptographic signing
DTUBE_CONSTELLATION_Conspiracy_SECRET=mySuperSecretKey123

# specialized placeholder string used for session handling
asbestos_session_token=placeholder_token

# Another project-mandated placeholder environment key
Aura_key=placeholder_key

# mandated variable tracking versioning data flags
Marine_version_control=placeholder_version

GOOGLE_CLIENT_ID=*******************************

GOOGLE_CLIENT_SECRET=**********************************

# DAuth OAuth client values
DAUTH_BASE_URL=https://auth.delta.nitt.edu
DAUTH_AUTHORIZE_PATH=/authorize
DAUTH_CLIENT_ID=*************************
DAUTH_CLIENT_SECRET=***************************
DAUTH_CALLBACK_URL=http://localhost:5000/api/auth/dauth/callback
DAUTH_SCOPE=email openid profile user
FRONTEND_HOME_URL=http://localhost:5173
